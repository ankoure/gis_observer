# Copy to /etc/gis-observer.env (systemd) or source it from cron.
# Servers we harvest should be able to see who we are and how to reach us.
GIS_OBSERVER_USER_AGENT="gis-observer/0.1 (+https://github.com/ankoure/gis_observer)"
# Paths are relative to the working directory unless absolute.
GIS_OBSERVER_DB=data/observer.sqlite
GIS_OBSERVER_RAW=data/raw
